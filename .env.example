# 复制本文件为 .env 并填入真实密钥。未配置时使用 mock provider 离线可运行。
# 模型供应商选择：mock | openai | qwen | hunyuan
MODEL_PROVIDER=mock

# ---------- OpenAI ----------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ---------- 通义千问（OpenAI 兼容接口） ----------
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# ---------- 混元（腾讯云） ----------
HUNYUAN_SECRET_ID=
HUNYUAN_SECRET_KEY=
HUNYUAN_MODEL=hunyuan-pro

# 单次报告预算上限（元）
BUDGET_CAP_CNY=2.0
